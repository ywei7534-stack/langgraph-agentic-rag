# Required: DeepSeek chat model
DEEPSEEK_API_KEY=sk-...

# Optional: enables the web-search tool
TAVILY_API_KEY=tvly-...

# Embeddings (local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
AGENTIC_RAG_EMBEDDING_MODEL=bge-m3

# Optional overrides
AGENTIC_RAG_LLM_MODEL=deepseek-chat
AGENTIC_RAG_INDEX_DIR=./data/faiss_index
AGENTIC_RAG_MAX_REWRITES=2
AGENTIC_RAG_RETRIEVAL_K=4
